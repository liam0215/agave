# Copy to local.env and edit for your machine. local.env is ignored by Git.
# A cloned source layout should have agave, solana-sdk, ed25519-dalek,
# ed25519-dalek-bip32, curve25519-dalek, and qat-shim as sibling directories.
QATLIB_SRC=/path/to/qat_driver
QATLIB_BUILD=/path/to/qat_driver/build
JUNCTION_RUN=/path/to/junction-arkose/build/junction/junction_run
JUNCTION_VALIDATOR_CONFIG=/path/to/junction_agave_validator.config
JUNCTION_BENCH_CONFIG=/path/to/junction_agave_bench.config

# Must match host_addr in the validator Junction configuration.
MASTER_HOST=192.168.120.7

# Optional: change when libqat_s.so lives outside QATLIB_BUILD.
# JUNCTION_LD_PATH=/path/containing/libqat_s.so
# Optional tuning; tune for the collaborator's hardware.
# SOLANA_BANKING_THREADS=6
# SOL_SIGVERIFY_THREADS=4
# BENCH_DURATION=50
# BENCH_TX_COUNT=50000
